---
import type { SiteContent } from '../data/site';

interface Props {
  content: SiteContent['hero'];
}

const { content } = Astro.props;
---

<section class="hero section-shell" id="hero" aria-labelledby="hero-heading">
  <div class="hero-copy" data-motion="hero-copy">
    <h1 id="hero-heading">{content.heading}</h1>
    <p class="hero-intro">{content.intro}</p>
    <div class="hero-actions">
      <a class="primary-action" href="/beratung">
        Snack-Finder starten
        <span class="action-mark" aria-hidden="true">↗</span>
      </a>
      <a class="secondary-action" href="#produkte">{content.ctaLabel}</a>
    </div>
  </div>

  <div class="hero-stage" aria-hidden="true" data-motion="hero-stage">
    <span class="hero-word">besser snacken</span>
    <img
      class="hero-machine"
      data-motion="hero-machine"
      src="/vendor.webp"
      alt=""
      width="1883"
      height="2423"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>
