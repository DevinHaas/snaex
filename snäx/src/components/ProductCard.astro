---
import { Image } from 'astro:assets';

import type { CatalogProduct } from '../data/catalog';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
---

<article class="product-card" data-product-category={product.category} data-motion="product-card">
  <div class="product-visual">
    <Image
      src={product.image}
      alt={product.imageAlt}
      widths={[320, 480, 640]}
      sizes="(max-width: 42rem) 80vw, (max-width: 64rem) 42vw, 22vw"
      loading="lazy"
      data-motion="product-image"
    />
  </div>
  <div class="product-copy">
    <CategoryBadge category={product.category} />
    <h3>{product.name}</h3>
    <p>{product.unit}</p>
  </div>
</article>
