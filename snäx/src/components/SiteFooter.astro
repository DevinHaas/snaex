---
import type { ContactDetails } from '../data/site';
import logo from '../assets/brand/logo-light.png';

interface Props {
  contactDetails: ContactDetails;
  linkPrefix?: '' | '/';
}

const { contactDetails, linkPrefix = '' } = Astro.props;
const legalLinks = contactDetails.status === 'approved' ? contactDetails.legalLinks : [];
---

<footer class="site-footer">
  <a class="footer-brand" href={`${linkPrefix}#hero`} aria-label="Snäx Startseite">
    <img
      src={logo.src}
      width={logo.width}
      height={logo.height}
      class="footer-logo"
      alt="Snäx – Simply Better Snacking."
    />
  </a>
  <p>Snäx · Simply Better Snacking.</p>
  <nav aria-label="Fußnavigation">
    {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="#seitenanfang">Nach oben</a>
  </nav>
</footer>
