---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/og-snax.jpg', Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="Snäx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Snäx – Simply Better Snacking." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: Gesunde Verpflegung wird als ein nahbarer, handverlesener Teil des Alltags gezeigt; keine generische Karten-Landingpage.
      OWN-WORLD: Snäx Dunkelgrün, Salbei, Creme und Sand bilden weiche Flächen mit großzügiger, editorialer Typografie.
      STORY: Angebot verstehen, Auswahlprinzipien kennenlernen und den Kontaktbereich erreichen.
      FIRST VIEWPORT: Kompakter Anker-Header über einem großformatigen typografischen Hero mit direktem Weg zum Sortiment.
      FORM: Editorial-organisch, in der Design-Diskussion als Option A gewählt; seed key outline-option-a.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <noscript><span data-no-js-marker hidden></span></noscript>
    <slot />
  </body>
</html>
