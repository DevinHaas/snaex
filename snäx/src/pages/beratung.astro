---
import { Image } from 'astro:assets';

import logo from '../assets/brand/logo.png';
import { productCategoryLabels, publishedProducts } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dein Snack-Finder | Snäx"
  description="Finde mit vier kurzen Fragen die am besten passenden Produkte aus dem Snäx Sortiment."
>
  <a class="skip-link" href="#finder">Zum Snack-Finder springen</a>
  <header class="advisor-header">
    <a href="/" aria-label="Zur Snäx Startseite">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Snäx – Simply Better Snacking." />
    </a>
    <a href="/">Zurück zur Übersicht</a>
  </header>

  <main class="advisor-shell" id="finder" tabindex="-1">
    <header class="advisor-intro">
      <h1>Was passt jetzt zu dir?</h1>
      <p>Vier kurze Schritte. Bis zu fünf passende Produkte – mit Bild, Kategorie und Fit-Score.</p>
    </header>

    <form class="advisor-form" id="snack-finder" novalidate>
      <ol class="advisor-progress" aria-label="Fortschritt">
        <li aria-current="step"><span>1</span> Filter</li>
        <li><span>2</span> Ziel</li>
        <li><span>3</span> Moment</li>
        <li><span>4</span> Vorlieben</li>
      </ol>

      <section class="advisor-step" data-step="0" aria-labelledby="step-1-title">
        <fieldset>
          <legend id="step-1-title">Was sollen wir berücksichtigen?</legend>
          <p class="step-help">Nur Angaben, die Produkte wirklich ein- oder ausschliessen.</p>

          <div class="question-block question-inline">
            <p class="question-label">Bist du zwischen 18 und 65?</p>
            <div class="choice-grid choice-grid-two">
              <label><input type="radio" name="age" value="yes" required /> <span>Ja</span></label>
              <label><input type="radio" name="age" value="no" /> <span>Nein</span></label>
            </div>
          </div>

          <div class="question-block question-inline">
            <p class="question-label">Ernährungsform</p>
            <div class="choice-grid choice-grid-three">
              <label><input type="radio" name="diet" value="omnivore" required /> <span>Alles</span></label>
              <label><input type="radio" name="diet" value="vegetarian" /> <span>Vegetarisch</span></label>
              <label><input type="radio" name="diet" value="vegan" /> <span>Vegan</span></label>
            </div>
          </div>

          <details class="filter-details">
            <summary>Zutaten ausschliessen <span>optional</span></summary>
            <div class="filter-grid" data-allergies>
              <label><input type="checkbox" name="allergy" value="none" checked /> <span>Keine</span></label>
              <label><input type="checkbox" name="allergy" value="milk" /> <span>Milch</span></label>
              <label><input type="checkbox" name="allergy" value="gluten" /> <span>Gluten</span></label>
              <label><input type="checkbox" name="allergy" value="soy" /> <span>Soja</span></label>
              <label><input type="checkbox" name="allergy" value="nuts" /> <span>Nüsse</span></label>
              <label><input type="checkbox" name="allergy" value="other" /> <span>Andere</span></label>
            </div>
          </details>

          <div class="step-actions step-actions-end">
            <button type="button" class="button-primary" data-next>Weiter</button>
          </div>
        </fieldset>
      </section>

      <section class="advisor-step" data-step="1" aria-labelledby="step-2-title">
        <fieldset>
          <legend id="step-2-title">Was ist dir gerade wichtig?</legend>
          <p class="step-help">Wähle ein Ziel. Der Score bleibt eine Auswahlhilfe, kein Gesundheitswert.</p>
          <div class="choice-list goal-list">
            <label><input type="radio" name="goal" value="balanced" required /> <span><strong>Ausgewogene Pause</strong><small>Unkompliziert für den Alltag</small></span></label>
            <label><input type="radio" name="goal" value="satiety" /> <span><strong>Länger zufrieden</strong><small>Geplante Portion bis zur nächsten Mahlzeit</small></span></label>
            <label><input type="radio" name="goal" value="recovery" /> <span><strong>Nach dem Krafttraining</strong><small>Produkte mit Proteinbezug zuerst</small></span></label>
            <label><input type="radio" name="goal" value="endurance" /> <span><strong>Ausdauer &amp; Aktivität</strong><small>Passend zum Zeitpunkt der Belastung</small></span></label>
            <label><input type="radio" name="goal" value="hydration" /> <span><strong>Etwas trinken</strong><small>Getränke werden stärker gewichtet</small></span></label>
          </div>

          <div class="step-actions">
            <button type="button" class="button-quiet" data-back>Zurück</button>
            <button type="button" class="button-primary" data-next>Weiter</button>
          </div>
        </fieldset>
      </section>

      <section class="advisor-step" data-step="2" aria-labelledby="step-3-title">
        <fieldset>
          <legend id="step-3-title">Für welchen Moment?</legend>
          <p class="step-help">Der Zeitpunkt verändert die Reihenfolge, nicht deine Sicherheitsfilter.</p>
          <div class="choice-grid occasion-grid">
            <label><input type="radio" name="occasion" value="everyday" required /> <span>Jetzt, ohne Sport</span></label>
            <label><input type="radio" name="occasion" value="before" /> <span>Vor der Aktivität</span></label>
            <label><input type="radio" name="occasion" value="during" /> <span>Während der Aktivität</span></label>
            <label><input type="radio" name="occasion" value="after" /> <span>Nach der Aktivität</span></label>
          </div>

          <div class="duration-question" data-duration hidden>
            <p class="question-label">Wie lange ungefähr?</p>
            <div class="choice-grid choice-grid-two">
              <label><input type="radio" name="duration" value="short" /> <span>Bis 1 Stunde</span></label>
              <label><input type="radio" name="duration" value="long" /> <span>Länger</span></label>
            </div>
          </div>

          <div class="step-actions">
            <button type="button" class="button-quiet" data-back>Zurück</button>
            <button type="button" class="button-primary" data-next>Weiter</button>
          </div>
        </fieldset>
      </section>

      <section class="advisor-step" data-step="3" aria-labelledby="step-4-title">
        <fieldset>
          <legend id="step-4-title">Was magst du lieber?</legend>
          <p class="step-help">Vorlieben verändern den Fit-Score, überschreiben aber keinen Filter.</p>

          <div class="question-block question-inline">
            <p class="question-label">Geschmack</p>
            <div class="choice-grid choice-grid-three">
              <label><input type="radio" name="taste" value="sweet" required /> <span>Süss</span></label>
              <label><input type="radio" name="taste" value="savoury" /> <span>Herzhaft</span></label>
              <label><input type="radio" name="taste" value="either" /> <span>Egal</span></label>
            </div>
          </div>

          <div class="question-block question-inline">
            <p class="question-label">Getränk</p>
            <div class="choice-grid choice-grid-three">
              <label><input type="radio" name="drink" value="still" required /> <span>Still</span></label>
              <label><input type="radio" name="drink" value="sparkling" /> <span>Sprudelnd</span></label>
              <label><input type="radio" name="drink" value="either" /> <span>Egal</span></label>
            </div>
          </div>

          <div class="step-actions">
            <button type="button" class="button-quiet" data-back>Zurück</button>
            <button type="submit" class="button-primary">Produkte anzeigen</button>
          </div>
        </fieldset>
      </section>
    </form>

    <section class="advisor-result" data-result hidden aria-labelledby="result-title" tabindex="-1">
      <header class="result-heading">
        <div>
          <p data-result-count></p>
          <h2 id="result-title" data-result-title></h2>
          <p data-result-intro></p>
        </div>
        <button type="button" class="button-quiet" data-restart>Antworten ändern</button>
      </header>

      <div class="recommendation-list" data-recommendation-list>
        {publishedProducts.map((product) => (
          <article class="recommendation-card" data-result-product={product.slug} hidden>
            <div class={`recommendation-image recommendation-image-${product.category}`}>
              <Image
                src={product.image}
                alt={product.imageAlt}
                widths={[280, 420, 560]}
                sizes="(max-width: 42rem) 82vw, (max-width: 72rem) 42vw, 22vw"
                loading="eager"
              />
              <strong class="fit-score"><span data-score>0</span>% Fit</strong>
            </div>
            <div class="recommendation-copy">
              <p class="recommendation-category">{productCategoryLabels[product.category]}</p>
              <h3>{product.name}</h3>
              <p data-reason></p>
              <div class="score-track" aria-hidden="true"><span data-score-bar></span></div>
              <p class="recommendation-fact">{product.nutritionClaims[0]?.label}</p>
              <a href={product.factSourceUrl} rel="noreferrer" target="_blank">Produktangaben prüfen</a>
            </div>
          </article>
        ))}
      </div>
      <p class="result-disclaimer">Allgemeine Orientierung für Lebensmittel, keine medizinische Beratung.</p>
    </section>

    <noscript><p class="no-script">Der interaktive Finder benötigt JavaScript. Das Sortiment findest du auf der Startseite.</p></noscript>
  </main>
</BaseLayout>

<script>
  import { recommendSnacks, type AdvisorProfile } from '../data/advisor';

  const form = document.querySelector<HTMLFormElement>('#snack-finder');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  const progress = Array.from(document.querySelectorAll<HTMLElement>('.advisor-progress li'));
  const result = document.querySelector<HTMLElement>('[data-result]');
  const recommendationList = document.querySelector<HTMLElement>('[data-recommendation-list]');
  let currentStep = 0;

  const selected = (name: string) =>
    form?.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)?.value;

  function showStep(index: number) {
    currentStep = index;
    steps.forEach((step, stepIndex) => {
      const active = stepIndex === index;
      step.hidden = !active;
      step.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button').forEach((control) => {
        control.disabled = !active;
      });
    });
    progress.forEach((item, itemIndex) => {
      if (itemIndex === index) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
      item.toggleAttribute('data-complete', itemIndex < index);
    });
    window.scrollTo(0, 0);
  }

  function validateStep() {
    const invalid = steps[currentStep]?.querySelector<HTMLInputElement>('input:invalid');
    if (!invalid) return true;
    invalid.reportValidity();
    return false;
  }

  form?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.name === 'allergy' && input.checked) {
      const choices = form.querySelectorAll<HTMLInputElement>('[name="allergy"]');
      if (input.value === 'none') choices.forEach((item) => { if (item !== input) item.checked = false; });
      else form.querySelector<HTMLInputElement>('[name="allergy"][value="none"]')!.checked = false;
    }

    if (input.name === 'occasion') {
      const duration = document.querySelector<HTMLElement>('[data-duration]');
      const during = input.value === 'during';
      if (duration) duration.hidden = !during;
      duration?.querySelectorAll<HTMLInputElement>('input').forEach((control) => {
        control.disabled = !during;
        control.required = during;
        if (!during) control.checked = false;
      });
    }
  });

  form?.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((button) => {
    button.addEventListener('click', () => {
      if (validateStep()) showStep(currentStep + 1);
    });
  });

  form?.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((button) => {
    button.addEventListener('click', () => showStep(currentStep - 1));
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!validateStep()) return;

    const profile: AdvisorProfile = {
      ageInScope: selected('age') === 'yes',
      allergies: Array.from(form.querySelectorAll<HTMLInputElement>('[name="allergy"]:checked')).map((input) => input.value),
      diet: selected('diet') as AdvisorProfile['diet'],
      goal: selected('goal') as AdvisorProfile['goal'],
      occasion: selected('occasion') as AdvisorProfile['occasion'],
      duration: selected('duration') as AdvisorProfile['duration'],
      taste: selected('taste') as AdvisorProfile['taste'],
      drink: selected('drink') as AdvisorProfile['drink'],
    };
    const matches = recommendSnacks(profile);

    document.querySelector<HTMLElement>('[data-result-title]')!.textContent = matches.title;
    document.querySelector<HTMLElement>('[data-result-intro]')!.textContent = matches.intro;
    document.querySelector<HTMLElement>('[data-result-count]')!.textContent = matches.recommendations.length
      ? `${matches.recommendations.length} Produkte · nach Fit sortiert`
      : 'Kein Match';

    document.querySelectorAll<HTMLElement>('[data-result-product]').forEach((card) => { card.hidden = true; });
    matches.recommendations.forEach((recommendation) => {
      const card = document.querySelector<HTMLElement>(`[data-result-product="${recommendation.slug}"]`);
      if (!card) return;
      card.querySelector<HTMLElement>('[data-score]')!.textContent = String(recommendation.score);
      card.querySelector<HTMLElement>('[data-reason]')!.textContent = recommendation.reason;
      card.querySelector<HTMLElement>('[data-score-bar]')!.style.width = `${recommendation.score}%`;
      card.hidden = false;
      recommendationList?.append(card);
    });

    form.hidden = true;
    if (result) {
      result.hidden = false;
      result.focus();
    }
  });

  document.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
    if (result) result.hidden = true;
    if (form) {
      form.hidden = false;
      form.reset();
    }
    const duration = document.querySelector<HTMLElement>('[data-duration]');
    if (duration) duration.hidden = true;
    showStep(0);
  });

  showStep(0);
</script>

<style>
  .advisor-header,
  .advisor-shell {
    width: min(100% - (2 * var(--page-gutter)), 88rem);
    margin-inline: auto;
  }

  .advisor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 5.5rem;
    border-bottom: 1px solid rgb(31 61 42 / 24%);
  }

  .advisor-header img {
    width: clamp(7rem, 10vw, 8.75rem);
    height: auto;
  }

  .advisor-header > a:last-child {
    font-weight: 800;
  }

  .advisor-shell {
    display: grid;
    align-content: center;
    min-height: calc(100svh - 5.5rem);
    padding-block: clamp(1.5rem, 4svh, 3.5rem);
  }

  .advisor-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 3.5svh, 3rem);
  }

  .advisor-intro h1 {
    max-width: none;
    font-size: clamp(2.5rem, 4.5vw, 4.25rem);
  }

  .advisor-intro p {
    max-width: 34rem;
    margin: 0;
    font-size: 1rem;
  }

  .advisor-form {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: min(39rem, calc(100svh - 13rem));
  }

  .advisor-progress {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0 0 clamp(1.5rem, 3.5svh, 3rem);
    padding: 0;
    list-style: none;
    border-bottom: 1px solid rgb(31 61 42 / 24%);
  }

  .advisor-progress li {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.35rem;
    padding-bottom: 0.7rem;
    color: rgb(31 61 42 / 52%);
    font-size: 0.8rem;
    font-weight: 800;
    text-align: center;
  }

  .advisor-progress li::after {
    position: absolute;
    right: 18%;
    bottom: -2px;
    left: 18%;
    height: 3px;
    background: transparent;
    content: '';
  }

  .advisor-progress span {
    display: grid;
    place-items: center;
    width: 1.8rem;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .advisor-progress li[aria-current='step'],
  .advisor-progress li[data-complete] {
    color: var(--color-ink);
  }

  .advisor-progress li[aria-current='step']::after {
    background: var(--color-ink);
  }

  .advisor-step[hidden],
  .advisor-form[hidden],
  .advisor-result[hidden],
  .recommendation-card[hidden],
  .duration-question[hidden] {
    display: none;
  }

  .advisor-step,
  .advisor-step fieldset {
    min-height: 100%;
  }

  .advisor-step fieldset {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    max-width: 22ch;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.5vw, 2.35rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .step-help {
    max-width: 58ch;
    margin: 0.65rem 0 clamp(1.5rem, 3svh, 2.25rem);
    color: var(--color-accent);
  }

  .question-block + .question-block {
    margin-top: 1.5rem;
  }

  .question-inline {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(20rem, 1fr);
    align-items: center;
    gap: 1.5rem;
  }

  .question-label {
    margin: 0;
    font-weight: 900;
  }

  .choice-grid,
  .filter-grid {
    display: grid;
    gap: 0.75rem;
  }

  .choice-grid-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .choice-grid-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .occasion-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .filter-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 0.75rem;
  }

  .choice-grid label,
  .filter-grid label,
  .choice-list label {
    position: relative;
    cursor: pointer;
  }

  .choice-grid input,
  .filter-grid input,
  .choice-list input {
    position: absolute;
    opacity: 0;
  }

  .choice-grid span,
  .filter-grid span,
  .choice-list > label > span {
    display: flex;
    min-height: 3.1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgb(31 61 42 / 30%);
    border-radius: 0.9rem;
    background: rgb(245 243 236 / 62%);
    font-weight: 800;
  }

  .choice-grid span,
  .filter-grid span {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .choice-grid input:checked + span,
  .filter-grid input:checked + span,
  .choice-list input:checked + span {
    color: var(--color-canvas);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .choice-grid input:focus-visible + span,
  .filter-grid input:focus-visible + span,
  .choice-list input:focus-visible + span {
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }

  .filter-details {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border-radius: 1rem;
  }

  .filter-details summary {
    font-weight: 900;
    cursor: pointer;
  }

  .filter-details summary span {
    margin-left: 0.4rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .choice-list {
    display: grid;
    gap: 0.75rem;
  }

  .goal-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .choice-list > label > span {
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
  }

  .choice-list small {
    font-weight: 500;
    opacity: 0.78;
  }

  .duration-question {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border-radius: 1rem;
  }

  .step-actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .step-actions-end {
    justify-content: flex-end;
  }

  button {
    min-height: 3rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    font-weight: 900;
    cursor: pointer;
  }

  .button-primary {
    color: var(--color-canvas);
    background: var(--color-ink);
  }

  .button-primary:hover {
    background: var(--color-accent);
  }

  .button-quiet {
    color: var(--color-ink);
    background: transparent;
  }

  .advisor-result {
    padding-block: 1.5rem 4rem;
  }

  .result-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .result-heading > div > p:first-child,
  .recommendation-category {
    margin: 0 0 0.4rem;
    color: var(--color-accent);
    font-weight: 900;
  }

  .result-heading h2 {
    font-size: clamp(2rem, 3.2vw, 3.25rem);
  }

  .result-heading > div > p:last-child {
    max-width: 58ch;
    margin: 0.8rem 0 0;
  }

  .recommendation-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    max-width: 64rem;
  }

  .recommendation-card {
    display: grid;
    grid-template-columns: minmax(10rem, 0.75fr) minmax(0, 1.25fr);
    overflow: hidden;
    border: 1px solid rgb(31 61 42 / 24%);
    border-radius: 1.5rem;
    background: rgb(245 243 236 / 76%);
  }

  .recommendation-image {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 17rem;
    padding: 1rem;
    background: var(--color-sage);
  }

  .recommendation-image-getraenk { background: #cbd9df; }
  .recommendation-image-low-carb { background: #d7c5a7; }
  .recommendation-image-snack { background: #d9c69e; }

  .recommendation-image img {
    width: 100%;
    max-height: 14rem;
    object-fit: contain;
  }

  .fit-score {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.45rem 0.65rem;
    color: var(--color-canvas);
    background: var(--color-ink);
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .recommendation-copy {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
  }

  .recommendation-copy h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .recommendation-copy > p:not(.recommendation-category, .recommendation-fact) {
    margin: 0.7rem 0;
    font-size: 0.9rem;
    line-height: 1.45;
