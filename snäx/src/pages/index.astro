---
import BrandLogo from '../components/BrandLogo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteContent } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Snäx – einfach besser snacken"
  description="Snäx bringt handverlesene, gesunde Snacks mit guten Zutaten und lokalem Fokus in den Alltag."
>
  <SiteHeader navigation={siteContent.navigation} />

  <main id="inhalt" tabindex="-1">
    <section class="hero section-shell" id="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow">{siteContent.hero.eyebrow}</p>
        <h1 id="hero-heading">{siteContent.hero.heading}</h1>
        <p class="hero-intro">{siteContent.hero.intro}</p>
        <a class="primary-action" href="#produkte">
          {siteContent.hero.ctaLabel}
          <span class="action-mark" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <div class="hero-word">snäx</div>
        <div class="machine">
          <span class="machine-light"></span>
          <span class="machine-window"></span>
          <span class="machine-slot"></span>
          <BrandLogo variant="light" lockup="mark" class="machine-mark" />
        </div>
        <span class="orbit orbit-one">frisch</span>
        <span class="orbit orbit-two">nah</span>
      </div>
    </section>

    <section class="products section-shell" id="produkte" aria-labelledby="products-heading">
      <div class="section-heading">
        <h2 id="products-heading">{siteContent.products.heading}</h2>
        <p>{siteContent.products.intro}</p>
      </div>
      <ul class="category-list" aria-label="Geplante Sortimentskategorien">
        {siteContent.products.categories.map((category) => <li>{category}</li>)}
      </ul>
      <p class="status-note">Sortiment in Recherche · Veröffentlichung nach Freigabe</p>
    </section>

    <section class="philosophy section-shell" id="philosophie" aria-labelledby="philosophy-heading">
      <h2 id="philosophy-heading">{siteContent.philosophy.heading}</h2>
      <blockquote>{siteContent.philosophy.statement}</blockquote>
      <ul class="principle-list" aria-label="Unsere Prinzipien">
        {siteContent.philosophy.principles.map((principle) => <li>{principle}</li>)}
      </ul>
    </section>

    <section class="team section-shell" id="team" aria-labelledby="team-heading">
      <div class="team-visual" aria-hidden="true">
        <span class="portrait portrait-one"></span>
        <span class="portrait portrait-two"></span>
        <span class="portrait portrait-three"><BrandLogo lockup="mark" /></span>
      </div>
      <div class="team-copy">
        <h2 id="team-heading">{siteContent.team.heading}</h2>
        <p>{siteContent.team.intro}</p>
      </div>
    </section>

    <section class="contact section-shell" id="kontakt" aria-labelledby="contact-heading">
      <BrandLogo variant="light" lockup="mark" class="contact-mark" />
      <div>
        <h2 id="contact-heading">{siteContent.contact.heading}</h2>
        <p>{siteContent.contact.intro}</p>
      </div>
      <a class="contact-action" href="#seitenanfang">
        {siteContent.contact.ctaLabel}
        <span aria-hidden="true">↑</span>
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <BrandLogo class="footer-logo" />
    <p>Snäx · Simply Better Snacking.</p>
    <a href="#seitenanfang">Nach oben</a>
  </footer>
</BaseLayout>
