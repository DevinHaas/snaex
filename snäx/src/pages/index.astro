---
import Contact from '../components/Contact.astro';
import CategoryGuide from '../components/CategoryGuide.astro';
import Hero from '../components/Hero.astro';
import Philosophy from '../components/Philosophy.astro';
import Products from '../components/Products.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Team from '../components/Team.astro';
import { siteContent } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Snäx – einfach besser snacken"
  description="Snäx bringt handverlesene, gesunde Snacks mit guten Zutaten und lokalem Fokus in den Alltag."
>
  <SiteHeader navigation={siteContent.navigation} />

  <main id="inhalt" tabindex="-1">
    <Hero content={siteContent.hero} />
    <Products content={siteContent.products} />
    <CategoryGuide content={siteContent.categoryGuide} />
    <Philosophy content={siteContent.philosophy} />
    <Team content={siteContent.team} />
    <Contact content={siteContent.contact} />
  </main>
  <SiteFooter contactDetails={siteContent.contact.details} />
</BaseLayout>

<script>
  import '../scripts/motion';
</script>
